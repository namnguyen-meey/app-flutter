# =============================================================================
# .gitignore dùng chung toàn repo.
# Lưu ý: pubspec.lock ở root PHẢI được commit (melos và Pub Workspaces
# khuyến nghị) để cả team và CI dùng đúng cùng một bộ version.
# =============================================================================

# --- Dart / Flutter ---
.dart_tool/
build/
coverage/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# --- IDE ---
# melos tự sinh cấu hình IntelliJ/Android Studio vào .idea/ khi bootstrap.
.idea/
*.iml
*.ipr
*.iws

# --- Hệ điều hành ---
.DS_Store

# --- Code sinh tự động ---
# Không commit code sinh ra: chạy `melos run gen` sau khi bootstrap để tạo
# lại. Tại sao? Diff PR gọn hơn, không bao giờ conflict ở file sinh tự động,
# và tránh lộ giá trị nhạy cảm (envied sinh file chứa giá trị biến môi trường).
*.g.dart
*.freezed.dart
