# Biến môi trường của flavor dev.
# File mẫu này được commit. File thật (.env.dev) do `melos run env:init`
# tạo ra và KHÔNG commit.
#
# Lưu ý bảo mật: mọi giá trị ở đây được build vào app, ai cũng có thể trích
# xuất từ file APK/IPA. KHÔNG BAO GIỜ đặt secret thật (API key bí mật, mật
# khẩu...) vào app. Secret phải nằm ở server.

API_BASE_URL=https://dummyjson.com
ENABLE_LOGS=true
# Thời gian sống của access token (phút). Token hết hạn sau 1 phút để dễ thử luồng tự làm mới token.
ACCESS_TOKEN_LIFETIME_MINUTES=1
