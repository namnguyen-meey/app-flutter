# Biến môi trường của flavor prod.
# File mẫu này được commit. File thật (.env.prod) do `melos run env:init`
# tạo ra và KHÔNG commit.
#
# Lưu ý bảo mật: mọi giá trị ở đây được build vào app, ai cũng có thể trích
# xuất từ file APK/IPA. KHÔNG BAO GIỜ đặt secret thật (API key bí mật, mật
# khẩu...) vào app. Secret phải nằm ở server.

API_BASE_URL=https://dummyjson.com
ENABLE_LOGS=false
# Thời gian sống của access token (phút). Tắt log ở bản phát hành.
ACCESS_TOKEN_LIFETIME_MINUTES=60
